rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /stories/{story} {
      allow read: if true;
      allow create, update: if request.resource.data.title is string && request.resource.data.title.size() <= 140
        && request.resource.data.body is string && request.resource.data.body.size() <= 20000
        && request.resource.data.author is string && request.resource.data.author.size() > 0 && request.resource.data.author.size() <= 50
        && request.resource.data.category in ['School', 'Class 10']
        && (!('thumb' in request.resource.data) || request.resource.data.thumb.size() <= 700000);
      allow delete: if true;
      match /files/{f} {
        allow read: if true;
        allow create: if request.resource.data.data.size() <= 950000;
        allow delete: if true;
      }
      match /comments/{c} {
        allow read: if true;
        allow create: if request.resource.data.keys().hasOnly(['name','text','created'])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 40
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 500
          && request.resource.data.created == request.time;
        allow delete: if true;
      }
    }
  }
}
